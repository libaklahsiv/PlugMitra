rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'vishal2a3a@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Profiles Collection: Isolated PII
    match /profiles/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Chargers Collection: Publicly discoverable listings for Chennai EV network
    match /chargers/{chargerId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.owner_id == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.owner_id == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.owner_id == request.auth.uid || isAdmin());
    }

    // Saved Chargers Bookmarks
    match /saved_chargers/{savedId} {
      allow get: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
    }

    // Bookings Collection
    match /bookings/{bookingId} {
      allow get: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
    }
  }
}
