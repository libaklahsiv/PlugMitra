# PlugMitra Chennai Environment Configuration
# Copy this file to .env.local and populate with your Supabase project credentials.
# NEVER commit your service_role secret key to client-side code!

# Supabase Project URL (e.g. https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Client Public Key (safe for client-side browsers)
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
